@model NetCoreArchiveSystem.Models.Klasor

@{
    ViewData["Title"] = Model.Ad + " Detayı";
    var zorunluList = ViewBag.ZorunluList as List<string>;
    var eksikList = ViewBag.EksikList as List<string>;
    var evraklar = ViewBag.Evraklar as List<NetCoreArchiveSystem.Models.Evrak>;
}

<div class="top-navbar">
    <div class="d-flex align-items-center gap-3">
        <a href="/Archive/Index" class="btn btn-light btn-sm rounded-circle shadow-sm" style="width: 35px; height: 35px; line-height: 25px;"><i class="bi bi-arrow-left"></i></a>
        <p class="m-0 text-muted" style="font-size: 14px;">Arşiv Sistemi / <strong class="text-dark">@Model.Ad</strong></p>
    </div>
</div>

<div class="container-fluid p-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sol Panel: Dosya Yükleme -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 mb-4 sticky-top" style="top: 20px;">
                <div class="card-header bg-primary text-white p-3 rounded-top-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-cloud-arrow-up-fill me-2"></i> Yeni Evrak Yükle</h6>
                </div>
                <div class="card-body p-4 bg-light">
                    <form action="/Archive/Upload" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="klasorId" value="@Model.Id">
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">Evrak Tipi Seçin</label>
                            <select class="form-select form-select-lg shadow-sm border-0" name="evrakTipi" required>
                                <option value="">-- Seçiniz --</option>
                                @foreach (var tip in zorunluList)
                                {
                                    <option value="@tip">@tip @(eksikList.Contains(tip) ? "(EKSİK)" : "")</option>
                                }
                            </select>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small">Dosya Seçin</label>
                            <input class="form-control form-control-lg shadow-sm border-0" type="file" name="dosya" required>
                        </div>
                        
                        <button type="submit" class="btn btn-primary btn-lg w-100 shadow fw-bold rounded-pill">
                            <i class="bi bi-upload me-2"></i> Yükle
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sağ Panel: Yüklü Dosyalar -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white p-4 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-files me-2 text-primary"></i> Klasör İçeriği</h5>
                        <span class="badge bg-primary rounded-pill px-3 py-2 shadow-sm fs-6">
                            @evraklar.Count / @zorunluList.Count Evrak
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Evrak Tipi</th>
                                    <th>Dosya Adı</th>
                                    <th>Yükleme Tarihi</th>
                                    <th class="text-end pe-4">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tip in zorunluList)
                                {
                                    var evrak = evraklar.FirstOrDefault(e => e.EvrakTipi == tip);
                                    if (evrak != null)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-success"><i class="bi bi-check-circle-fill me-2"></i> @tip</td>
                                            <td><span class="text-muted small">@evrak.DosyaAdi</span></td>
                                            <td><span class="badge bg-light text-dark border"><i class="bi bi-calendar3 me-1"></i> @evrak.YuklemeTarihi.ToString("dd.MM.yyyy HH:mm")</span></td>
                                            <td class="text-end pe-4">
                                                <a href="~/uploads/@evrak.DosyaAdi" target="_blank" class="btn btn-sm btn-info text-white shadow-sm rounded-pill px-3">
                                                    <i class="bi bi-eye-fill"></i> Aç
                                                </a>
                                                <form action="/Archive/Delete/@evrak.Id" method="post" class="d-inline">
                                                    <input type="hidden" name="klasorId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-sm btn-danger shadow-sm rounded-pill px-3" onclick="return confirm('Bu dosyayı silmek istediğinize emin misiniz?');">
                                                        <i class="bi bi-trash-fill"></i> Sil
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr class="table-warning">
                                            <td class="ps-4 fw-bold text-danger"><i class="bi bi-exclamation-circle-fill me-2"></i> @tip</td>
                                            <td colspan="3" class="text-muted fst-italic">Henüz yüklenmedi</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
